{
  "rev": "2026-09-25.3",
  "note": "官方规范预置表（s101/W2，裁决 docs/verdicts/2026-09-23-thinking-native-params-official-presets.md §2.1）。数据逐条来自 docs/research/40（GLM/DeepSeek 官方）、42（中国 8 厂 26 模型）、43（国际 5 厂 19 模型）的官方规范事实表，只搬不编。位置=conf 只读资源（先例：conf/templates/chat.tpl.html 由桥运行时 ROOT/conf 直读、conf/process-compose.yaml 启动时直读）——产品自有静态数据，随包发布、随版本覆盖，无需 bootstrap 物化（物化只为 bin/ 生成物与 data/ 运行时物服务，两者语义不同）。",
  "schema": {
    "match": "host_contains?（host 子串，(host,model) 二元组优先层）+ model（精确串）| model_regex（锚定正则，厂系默认层）。research/42 §7.D 硬证据：同一模型跨平台能力/默认不同，故 host 层先于 model 层。",
    "context_len": "官方上下文窗口 token 数；无官方数字=null（不编造）",
    "max_output": "官方最大输出 token 数；无官方数字=null",
    "input": "官方输入模态（image/pdf/video）；官方未载=false 并在 note 标注",
    "thinking.mode": "native=同模型官方档位 / switch=同模型官方布尔开关（可另带档位，如百炼直供 stepfun 开关+档混排）/ budget=预算族 / none=无任何官方思考控制键 / null=官方未载（诚实缺省，presetThinking 兜 none）",
    "thinking.keys": "官方原生键名逐字（写侧已实现四族：reasoning_effort / output_config / enable_thinking / EnableThinking；未实现族 thinking / thinking_budget / reasoning / thinkingConfig / thinking_strategy 由写侧过滤或安全回落，各族理由见 chat-bridge.tpl.js THINK_KEY_WRITERS 上方注释）",
    "thinking.levels": "官方原生档位值域（有序，逐字）；无档=[]；官方未载=null",
    "thinking.default": "官方默认档；无档模型用 on/off 表示开关默认态；官方未载=null",
    "thinking.off_supported": "官方是否支持关闭思考",
    "verified": "VERIFIED-DOC=官方原文/机读 schema 直取；UNVERIFIED=文档缺失或仅间接证据"
  },
